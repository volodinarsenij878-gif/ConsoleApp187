    using System;
    using System.Collections.Generic;
    using System.Linq;
    using System.Text;
    using System.Threading.Tasks;

    namespace Program38
    {
    internal class Program
    {
        static void Main()
        {
            Console.Write("Двузначное число: ");
            if (int.TryParse(Console.ReadLine(), out int n) && n >= 10 && n <= 99)
            {
                int tens = n / 10;
                int ones = n % 10;
                Console.WriteLine(tens == ones ? "Содержит одинаковые цифры" : "Цифры разные");
            }
            else
            {
                Console.WriteLine("Ошибка: введите двузначное число.");
            }
        }
    }
    }
